# ==============================================================================
# SalesPulse Analytics - Environment Configuration Template
# ==============================================================================
# NOTE: Never commit sensitive keys or real credentials to Git!
# Copy this file to .env and configure values appropriate for your environment.

# Storage Mode: 'local' (recommended for offline/0-cost development) or 's3'
STORAGE_MODE=local

# AWS Cloud Settings (only needed if STORAGE_MODE=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=salespulse-analytics-dataset
# If running locally with AWS, set these or use ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Spark Configuration for Local Execution
SPARK_APP_NAME=SalesPulse-Analytics
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g

# Currency and Localization
DEFAULT_CURRENCY=£

# Data Paths
RAW_DATA_PATH=data/raw/OnlineRetail.csv
PROCESSED_DATA_DIR=data/processed
ANALYTICS_DATA_DIR=data/analytics
REPORTS_DIR=data/reports
METADATA_DIR=data/metadata
